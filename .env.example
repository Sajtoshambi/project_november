# ==============================================================================
# Full-Stack Application Environment Configuration (.env)
# Used everywhere: Vite, Express, Drizzle ORM, and Docker Compose
# ==============================================================================

# Project Name (used as prefix for containers, compose project, etc.)
PROJECT_NAME=open-day

# Application Ports
BACKEND_PORT=3000
FRONTEND_PORT=5173
AUTH_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
AUTH_ADMIN_NAME=Open Day Administrator
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=replace-with-a-strong-password

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=open_day
